OPENAI_API_KEY=
# Use a URL-safe random password, shared by Postgres and DATABASE_URL.
POSTGRES_PASSWORD=
POSTGRES_PORT=55438
DATABASE_URL=postgresql://pools:REPLACE_WITH_POSTGRES_PASSWORD@127.0.0.1:55438/pools
# Optional: long random key for /owner sign-in and POST /api/pools/refresh
POOLS_API_SECRET=
